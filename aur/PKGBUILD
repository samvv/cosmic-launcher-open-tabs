# Maintainer: Sam Vervaeck <samvv-opensource.everglade575@passmail.net>

pkgname=cosmic-launcher-open-tabs-git
_pkgname=cosmic-launcher-open-tabs
pkgver=r1.e163b29
pkgrel=1
pkgdesc="Search and switch to open browser tabs from COSMIC Launcher (needs the companion Chromium extension)"
arch=('x86_64' 'aarch64')
url="https://github.com/samvv/cosmic-launcher-open-tabs"
license=('MPL-2.0')
depends=('gcc-libs' 'glibc' 'pop-launcher')
makedepends=('cargo' 'git')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("git+$url.git")
sha256sums=('SKIP')

_plugindir=/usr/lib/pop-launcher/plugins/browser-tabs

# System-wide native messaging host directories, per browser.
_hostdirs=(
  etc/chromium/native-messaging-hosts      # Chromium
  etc/opt/chrome/native-messaging-hosts    # Google Chrome (all channels)
  etc/opt/edge/native-messaging-hosts      # Microsoft Edge
)

pkgver() {
  cd "$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_pkgname/plugin"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname/plugin"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$_pkgname"
  install -Dm755 plugin/target/release/browser-tabs "$pkgdir$_plugindir/browser-tabs"
  install -Dm644 plugin/plugin.ron "$pkgdir$_plugindir/plugin.ron"

  local dir
  for dir in "${_hostdirs[@]}"; do
    install -d "$pkgdir/$dir"
    sh plugin/native-host-manifest.sh "$_plugindir/browser-tabs" \
      > "$pkgdir/$dir/be.samvervaeck.cosmic_launcher_open_tabs.json"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
