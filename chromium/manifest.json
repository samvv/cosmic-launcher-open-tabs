{
  "manifest_version": 3,
  "name": "Browser Tabs for COSMIC Launcher",
  "version": "0.1.0",
  "description": "Search and switch to your open tabs from COSMIC Launcher. Requires the companion launcher plugin.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "welcome.html",
    "open_in_tab": true
  }
}
